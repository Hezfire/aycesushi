# Copy this file to `.env.local` for local `vercel dev` (do NOT commit real keys).
# On the public site, set the same values in Vercel → Project → Settings → Environment Variables.

GEMINI_API_KEY=paste_your_free_google_ai_studio_key_here

# Neon Postgres connection string (required for restaurant leaderboards)
# Create a free project at https://console.neon.tech → copy the connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Optional — change only if Google renames models
# GEMINI_MODEL=gemini-3.6-flash
